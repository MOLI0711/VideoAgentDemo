# Build from the repository root. Image arguments allow an approved registry mirror.
ARG NODE_IMAGE=docker.io/library/node:24.21.0-bookworm-slim
ARG NGINX_IMAGE=docker.io/library/nginx:1.30.6-alpine3.24

FROM ${NODE_IMAGE} AS build
WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Deliberately allowlist frontend inputs: no .env, .runtime, or private config.
COPY web/index.html web/tsconfig.json web/vite.config.ts ./
COPY web/src ./src
RUN npm run build

FROM ${NGINX_IMAGE} AS runtime
COPY deploy/nginx.local.conf /etc/nginx/conf.d/default.conf
COPY LICENSE /usr/share/doc/vedioagent/LICENSE
COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
